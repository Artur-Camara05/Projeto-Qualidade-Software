{
  "name": "projeto-qualidade-software",
  "version": "1.0.0",
  "description": "**Sistema escolhido:** [Practice Software Testing](https://practicesoftwaretesting.com/).",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:regressao": "playwright test --grep CT-",
    "test:smoke": "playwright test --grep \"CT-0[1-5] -\"",
    "test:stub": "playwright test --grep SIM-",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "test:ci": "playwright test --project=chromium --forbid-only",
    "test:pipeline": "node --test scripts/verificar-resultados.test.js",
    "check:results": "node scripts/verificar-resultados.js",
    "report": "playwright show-report reports/html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BrunoFerreiraLyra/projeto-qualidade-software.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/BrunoFerreiraLyra/projeto-qualidade-software/issues"
  },
  "homepage": "https://github.com/BrunoFerreiraLyra/projeto-qualidade-software#readme",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6"
  }
}
